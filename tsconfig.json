{
  "compilerOptions": {
    "target": "ES2022",
    "lib": [
      "ES2022"
    ],
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "strict": true,
    "noUncheckedIndexedAccess": true,
    "exactOptionalPropertyTypes": false,
    "noImplicitOverride": true,
    "resolveJsonModule": true,
    "isolatedModules": true,
    "verbatimModuleSyntax": true,
    "allowImportingTsExtensions": true,
    "noEmit": true,
    "skipLibCheck": true,
    "types": [
      "node"
    ]
  },
  "include": [
    "packages/engine/src/**/*.ts",
    "packages/engine/test/**/*.ts",
    "packages/cards/src/**/*.ts",
    "packages/cards/test/**/*.ts",
    "packages/i18n/src/**/*.ts",
    "packages/i18n/test/**/*.ts",
    "packages/ai/src/**/*.ts",
    "packages/ai/test/**/*.ts",
    "packages/meta/src/**/*.ts",
    "packages/meta/test/**/*.ts",
    "packages/protocol/src/**/*.ts",
    "packages/server/src/**/*.ts",
    "packages/server/test/**/*.ts",
    "packages/tools/src/**/*.ts",
    "packages/tools/test/**/*.ts",
    "vitest.config.ts"
  ]
}
