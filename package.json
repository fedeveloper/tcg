{
  "name": "tcg",
  "private": true,
  "license": "UNLICENSED",
  "type": "module",
  "packageManager": "pnpm@10.28.0",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run",
    "validate:cards": "tsx packages/tools/src/validate-cards.ts",
    "check:i18n": "tsx packages/tools/src/check-i18n.ts",
    "sim": "tsx packages/tools/src/sim.ts",
    "play": "tsx packages/tools/src/cli.ts",
    "assets": "python3 assets/src/build.py",
    "check": "pnpm typecheck && pnpm test && pnpm validate:cards && pnpm check:i18n && pnpm sim --games 500",
    "duel": "tsx packages/tools/src/duel.ts"
  },
  "devDependencies": {
    "@types/node": "^22.15.0",
    "fast-check": "^4.3.0",
    "tsx": "^4.20.0",
    "typescript": "~5.9.3",
    "vitest": "^3.2.4"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "esbuild"
    ]
  }
}
